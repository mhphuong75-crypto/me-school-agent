# Copy this file to .env and fill in your values

# Required: Your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Required: Root path to the manual folder on this machine
# Example: /Users/yourname/Documents/Projects/ME School/OneDrive_1_10-05-2026
MANUAL_ROOT=/Users/phuongmai/Documents/Projects/ME School/OneDrive_1_10-05-2026

# Optional: OneDrive base URL so file links are clickable in the browser
# Share the entire manual folder with "Anyone with link can view" in OneDrive,
# then paste the base URL here.
# Example: https://d.docs.live.net/xxxx/ME School Manual/
ONEDRIVE_BASE_URL=

# Optional: Simple password to protect the public app (leave blank = no password)
APP_PASSWORD=
